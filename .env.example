# Copie este arquivo para .env.local e ajuste os valores.

# Número de WhatsApp da loja: SOMENTE dígitos, com DDI + DDD (Brasil = 55).
# Exemplo: 5511999999999
# Sem valor, os links abrem o WhatsApp com a mensagem pronta e o visitante escolhe o contato.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública do site (com https://, sem barra final). Usada em metadados, sitemap e Open Graph.
# Em branco ou inválida, o site usa http://localhost:3000 (não quebra o build).
# Em produção defina o domínio real, ex.: https://www.silveiraiphones.com.br
NEXT_PUBLIC_SITE_URL=
